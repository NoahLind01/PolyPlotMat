    function clearBaselineVisualization(app)
        % Clear ONLY baseline elements, preserve selection elements
        
        allChildren = get(app.APPlot, 'Children');
        
        for i = 1:length(allChildren)
            obj = allChildren(i);
            shouldDelete = false;
            
            if isprop(obj, 'DisplayName') && ~isempty(obj.DisplayName)
                % Delete anything with "Baseline" in the name
                if contains(obj.DisplayName, 'Baseline') || ...
                   contains(obj.DisplayName, 'Rolling Ball') || ...
                   contains(obj.DisplayName, 'Quantile') || ...
                   contains(obj.DisplayName, 'Floor Zero') || ...
                   contains(obj.DisplayName, 'Local Min') || ...
                   contains(obj.DisplayName, 'Curve Min')
                    shouldDelete = true;
                end
            end
            
            % Delete baseline-specific graphics by type and style
            if isa(obj, 'matlab.graphics.chart.primitive.Line')
                % Delete dashed lines that are blue, green, red, or magenta (baseline lines)
                if strcmp(obj.LineStyle, '--') || strcmp(obj.LineStyle, ':')
                    if length(obj.Color) == 3
                        % Check if it's a baseline color (not gray selection lines)
                        if ~isequal(obj.Color, [0.5, 0.5, 0.5]) % Don't delete gray selection lines
                            shouldDelete = true;
                        end
                    end
                end
            end
            
            if isa(obj, 'matlab.graphics.chart.primitive.Scatter')
                % Delete filled squares, diamonds (baseline markers)
                if strcmp(obj.Marker, 's') || strcmp(obj.Marker, 'd')
                    shouldDelete = true;
                end
            end
            
            if shouldDelete
                try
                    delete(obj);
                catch
                    % Continue if deletion fails
                end
            end
        end
        
        drawnow;
        fprintf('Baseline-only clearing completed (selection preserved)\n');
    end

    function cleanupLegend(app)
        % Clean up legend to only show desired entries
        
        % Get all graphics objects in the plot
        allObjects = get(app.APPlot, 'Children');
        
        % Define which DisplayNames we want to keep in the legend
        desiredLegendEntries = {'Fitted Baseline', 'Baseline Points'};
        
        % Find objects with desired DisplayNames
        legendObjects = [];
        legendLabels = {};
        
        for i = 1:length(allObjects)
            obj = allObjects(i);
            if isprop(obj, 'DisplayName') && ~isempty(obj.DisplayName)
                if any(strcmp(obj.DisplayName, desiredLegendEntries))
                    legendObjects = [legendObjects; obj];
                    legendLabels{end+1} = obj.DisplayName;
                else
                    % Hide unwanted objects from legend
                    obj.Annotation.LegendInformation.IconDisplayStyle = 'off';
                end
            else
                % Hide objects without DisplayName from legend
                if isprop(obj, 'Annotation') && isprop(obj.Annotation, 'LegendInformation')
                    obj.Annotation.LegendInformation.IconDisplayStyle = 'off';
                end
            end
        end
        
        % Update legend with only desired entries
        if ~isempty(legendObjects)
            legend(app.APPlot, legendObjects, legendLabels, 'Location', 'best');
        else
            legend(app.APPlot, 'off');
        end
    end

