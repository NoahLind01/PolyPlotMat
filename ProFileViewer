    function [peakStart, peakEnd] = findPeakBoundariesByValleys(app, xData, yData, peakX)
        % Find valleys on either side of peak to determine boundaries
        
        % Find peak index
        [~, peakIdx] = min(abs(xData - peakX));
        
        % Search range (±50 points or 10mm, whichever is smaller)
        searchPoints = 50;
        searchDistance = 10.0; % mm
        
        % Convert search distance to points
        dx = median(diff(xData));
        maxSearchPoints = round(searchDistance / dx);
        actualSearchPoints = min(searchPoints, maxSearchPoints);
        
        % Find valley to the left
        leftStart = max(1, peakIdx - actualSearchPoints);
        leftRange = leftStart:peakIdx;
        [~, leftMinIdx] = min(yData(leftRange));
        leftValleyIdx = leftRange(leftMinIdx);
        peakStart = xData(leftValleyIdx);
        
        % Find valley to the right  
        rightEnd = min(length(xData), peakIdx + actualSearchPoints);
        rightRange = peakIdx:rightEnd;
        [~, rightMinIdx] = min(yData(rightRange));
        rightValleyIdx = rightRange(rightMinIdx);
        peakEnd = xData(rightValleyIdx);
        
        % Ensure reasonable minimum width
        minPeakWidth = 2.0; % mm
        if (peakEnd - peakStart) < minPeakWidth
            % Expand boundaries to minimum width
            peakCenter = peakX;
            peakStart = peakCenter - minPeakWidth/2;
            peakEnd = peakCenter + minPeakWidth/2;
            
            % Keep within data bounds (this should always execute)
            peakStart = max(min(xData), peakStart);
            peakEnd = min(max(xData), peakEnd);
        end
        
        fprintf('    Peak at %.2f: boundaries %.2f to %.2f (width: %.2f)\n', ...
            peakX, peakStart, peakEnd, peakEnd - peakStart);
    end

    function updateRunoffResultsTable(app)
        % Enhanced table with dynamic time units
        
        if isempty(app.runoffAnalysisTable)
            app.RunoffResultsTable.Data = {};
            app.RunoffResultsTable.ColumnName = {'File', 'Time', 'Condition', 'Peaks', 'Total AUC'};
            return;
        end
        
        try
            % Get time unit for column header
            if app.MinutesButton.Value     
                timeUnit = 'min'; 
            else     
                timeUnit = 's'; 
            end
            
            % Sort by time for better display
            sortedTable = sortrows(app.runoffAnalysisTable, 'Time');
            
            % Build display data
            numFiles = height(sortedTable);
            tableData = cell(numFiles, 6);
            
            for i = 1:numFiles
                % Clean filename display
                [~, shortName, ~] = fileparts(sortedTable.Filename{i});
                
                tableData{i, 1} = shortName;
                tableData{i, 2} = sortedTable.Time(i);
                tableData{i, 3} = sortedTable.Condition{i};
                tableData{i, 4} = sortedTable.PeakCount(i);
                tableData{i, 5} = sprintf('%.4f', sortedTable.TotalAUC(i));
                
                % Add peak positions summary
                positions = sortedTable.PeakPositions{i};
                if ~isempty(positions)
                    posStr = sprintf('%.1f', positions(1));
                    for j = 2:min(3, length(positions))
                        posStr = [posStr, sprintf(', %.1f', positions(j))];
                    end
                    if length(positions) > 3
                        posStr = [posStr, '...'];
                    end
                    tableData{i, 6} = posStr;
                else
                    tableData{i, 6} = 'None';
                end
            end
            
            % Update UI table with dynamic time unit
            app.RunoffResultsTable.Data = tableData;
            app.RunoffResultsTable.ColumnName = {'File', sprintf('Time (%s)', timeUnit), 'Condition', 'Peaks', 'Total AUC', 'Peak Positions'};
            
            fprintf('  Updated results table: %d files (sorted by time, %s scale)\n', numFiles, timeUnit);
            
        catch e
            fprintf('  Error updating results table: %s\n', E.message);
        end
    end

