    function smoothBaseline = quantileMorphologicalOpening(app, xData, yData, ballRadius, percentile)
        % Perform quantile-based morphological opening (key difference from minimum-based)
        %
        % Parameters:
        %   xData, yData - Input data
        %   ballRadius - Ball radius
        %   percentile - Percentile for erosion/dilation (10-25 typically)
        %
        % Returns:
        %   smoothBaseline - Baseline after quantile morphological opening
        
        % Convert ball radius to number of points
        dx = median(diff(xData));
        ballWidth = round(ballRadius / dx);
        ballWidth = max(3, ballWidth);
        
        % Quantile erosion: percentile filter instead of minimum
        eroded = app.percentileFilter(yData, ballWidth, percentile);
        
        % Quantile dilation: complementary percentile filter
        dilationPercentile = 100 - percentile; % If eroding at 15th, dilate at 85th
        smoothBaseline = app.percentileFilter(eroded, ballWidth, dilationPercentile);
    end
    
    function filtered = percentileFilter(app, data, windowSize, percentile)
        % Apply percentile filter - key method for quantile-based approach
        %
        % Parameters:
        %   data - Input data
        %   windowSize - Filter window size
        %   percentile - Percentile to use (0-100)
        %
        % Returns:
        %   filtered - Percentile filtered data
        
        filtered = data;
        halfWindow = floor(windowSize / 2);
        
        for i = 1:length(data)
            startIdx = max(1, i - halfWindow);
            endIdx = min(length(data), i + halfWindow);
            localWindow = data(startIdx:endIdx);
            
            % Use percentile instead of min/max
            filtered(i) = prctile(localWindow, percentile);
        end
    end
    
    function isValley = findQuantileValleys(app, yData, ballRadius, percentile)
        % Find valley regions using quantile-based criteria (better for broad peaks)
        % Depreciated
        % Parameters:
        %   yData - Input data
        %   ballRadius - Used to determine analysis window size
        %   percentile - Percentile threshold for valley detection
        %
        % Returns:
        %   isValley - Logical array indicating valley regions
        
        windowSize = max(7, round(length(yData) * 0.03)); % Larger window for broad peaks
        isValley = false(size(yData));
        
        for i = windowSize+1:length(yData)-windowSize
            localWindow = yData(i-windowSize:i+windowSize);
            centerValue = yData(i);
            
            % Check if center value is in bottom percentile of local window
            localThreshold = prctile(localWindow, percentile + 5); % Slightly above percentile
            
            if centerValue <= localThreshold
                isValley(i) = true;
            end
        end
    end

    function [baselineFit, baselineInfo] = quantileRollingBallBaseline(app, xData, yData, percentile)
        % Enhanced version with conservative full-coverage extension
        
        if nargin < 4
            percentile = 15;
        end
        
        % Clean data
        [xClean, yClean] = app.cleanDataForBaseline(xData, yData);
        
        % Get ball radius (adapt for runoff vs analysis context)
        if isprop(app, 'BaslineballradiusEditField') && app.BaslineballradiusEditField.Value > 0
            ballRadius = app.BaslineballradiusEditField.Value;
            fprintf('  - Using runoff ball radius: %.3f\n', ballRadius);
        elseif ~isempty(app.BallRadiusEditField.Value) && app.BallRadiusEditField.Value > 0
            ballRadius = app.BallRadiusEditField.Value;
            fprintf('  - Using analysis ball radius: %.3f\n', ballRadius);
        else
            ballRadius = app.calculateOptimalBallRadius(xClean, yClean);
        end
        
        % Use existing islocalmin-based approach
        [baselinePoints, baselineIndices] = app.applyQuantileRollingBall(xClean, yClean, ballRadius, percentile);
        
        % REUSE: Add conservative edge points using existing logic pattern
        originalCount = length(baselineIndices);
        baselineIndices = app.addConservativeEdgePoints(xClean, yClean, baselineIndices);
        baselinePoints = yClean(baselineIndices);
        
        if length(baselineIndices) > originalCount
            fprintf('    Added %d conservative edge points for coverage\n', length(baselineIndices) - originalCount);
        end
        
        % REUSE: existing interpolation method
        [baselineFit, quality] = app.interpolateBaseline(xClean, yClean, baselinePoints, baselineIndices);
        
        % Return info
        baselineInfo = struct();
        baselineInfo.ballRadius = ballRadius;
        baselineInfo.percentile = percentile;
        baselineInfo.numBaselinePoints = length(baselineIndices);
        baselineInfo.quality = quality;
        baselineInfo.baselineRegions = struct('x', xClean(baselineIndices), 'y', yClean(baselineIndices));
        
        finalCoverage = 100 * (max(xClean(baselineIndices)) - min(xClean(baselineIndices))) / (max(xClean) - min(xClean));
        fprintf('  - Final coverage: %.1f%% (%.3f to %.3f mm)\n', ...
            finalCoverage, min(xClean(baselineIndices)), max(xClean(baselineIndices)));
    end

    function enhancedIndices = addConservativeEdgePoints(app, xData, yData, existingIndices)
        % Conservatively add edge points - only if genuinely valleys
        
        dataSpan = max(xData) - min(xData);
        leftThreshold = min(xData) + 0.03 * dataSpan;  % First 3%
        rightThreshold = max(xData) - 0.03 * dataSpan; % Last 3%
        
        enhancedIndices = existingIndices;
        
        % LEFT EDGE: Only add if coverage gap is significant AND point is truly low
        leftCoverage = min(xData(existingIndices));
        if leftCoverage > leftThreshold
            leftGap = leftCoverage - min(xData);
            dataRange = max(yData) - min(yData);
            
            % Look for valleys in the left edge region
            leftRegion = xData <= leftThreshold;
            if any(leftRegion)
                leftIndices = find(leftRegion);
                leftValues = yData(leftIndices);
                
                % Find the minimum, but check if it's reasonable
                [minVal, minIdx] = min(leftValues);
                globalMin = min(yData);
                
                % Only add if: (1) significant gap, (2) point is reasonably low
                if leftGap > 5.0 && minVal <= (globalMin + 0.2 * dataRange)
                    leftPoint = leftIndices(minIdx);
                    enhancedIndices = [leftPoint; enhancedIndices];
                    fprintf('      Added left edge: X=%.3f, Y=%.6f (gap=%.1fmm)\n', ...
                        xData(leftPoint), yData(leftPoint), leftGap);
                else
                    fprintf('      Skipped left edge: gap=%.1fmm, val=%.6f (not conservative enough)\n', leftGap, minVal);
                end
            end
        end
        
        % RIGHT EDGE: Same logic
        rightCoverage = max(xData(existingIndices));
        if rightCoverage < rightThreshold
            rightGap = max(xData) - rightCoverage;
            
            rightRegion = xData >= rightThreshold;
            if any(rightRegion)
                rightIndices = find(rightRegion);
                rightValues = yData(rightIndices);
                
                [minVal, minIdx] = min(rightValues);
                globalMin = min(yData);
                dataRange = max(yData) - min(yData);
                
                if rightGap > 5.0 && minVal <= (globalMin + 0.2 * dataRange)
                    rightPoint = rightIndices(minIdx);
                    enhancedIndices = [enhancedIndices; rightPoint];
                    fprintf('      Added right edge: X=%.3f, Y=%.6f (gap=%.1fmm)\n', ...
                        xData(rightPoint), yData(rightPoint), rightGap);
                else
                    fprintf('      Skipped right edge: gap=%.1fmm, val=%.6f (not conservative enough)\n', rightGap, minVal);
                end
            end
        end
        
        % Sort by x-position
        [~, sortOrder] = sort(xData(enhancedIndices));
        enhancedIndices = enhancedIndices(sortOrder);
    end
    
    function [baselineFit, quality] = interpolatePolysomeBaselineWithEdges(app, xData, yData, baselinePoints, baselineIndices)
        % Enhanced interpolation that gently extends to edges when possible
        % Depreciated
        
        if length(baselineIndices) < 3
            minValue = min(yData);
            baselineFit = ones(size(xData)) * minValue;
            quality = 0.5;
            return;
        end
        
        try
            % Use linear interpolation (conservative)
            baselineFit = interp1(xData(baselineIndices), baselinePoints, xData, 'linear', 'extrap');
            
            % GENTLE edge extension - don't force dramatic changes
            edgeExtensionLimit = 0.1 * (max(yData) - min(yData)); % Max 10% of data range
            
            for i = 1:length(xData)
                % Find nearest baseline point
                distances = abs(xData(baselineIndices) - xData(i));
                [~, nearestIdx] = min(distances);
                nearestBaselineValue = baselinePoints(nearestIdx);
                
                % Don't let baseline deviate too far from nearest measured point
                maxAllowed = nearestBaselineValue + edgeExtensionLimit;
                minAllowed = nearestBaselineValue - edgeExtensionLimit;
                
                baselineFit(i) = max(minAllowed, min(maxAllowed, baselineFit(i)));
            end
            
            % Apply rolling ball constraint
            baselineFit = min(baselineFit, yData);
            
            % Light smoothing
            if length(xData) > 20
                smoothWindow = max(3, round(length(xData)/150));
                if mod(smoothWindow, 2) == 0, smoothWindow = smoothWindow + 1; end
                baselineFit = smoothdata(baselineFit, 'movmean', smoothWindow);
                baselineFit = min(baselineFit, yData); % Re-apply constraint
            end
            
            % Calculate quality
            residuals = yData(baselineIndices) - baselineFit(baselineIndices);
            quality = max(0, 1 - (std(residuals) / std(yData)));
            
            fprintf('  - Conservative edge-extended baseline: %.6f to %.6f\n', min(baselineFit), max(baselineFit));
            
        catch e
            fprintf('  - Interpolation error: %s\n', E.message);
            avgBaseline = mean(baselinePoints);
            baselineFit = ones(size(xData)) * avgBaseline;
            quality = 0.3;
        end
    end
    
    function constrainedBaseline = applyPolysomeConstraints(app, xData, yData, baselineFit)
        % Apply biological constraints specific to polysome profiling data
        % Depreciated
        %
        % Parameters:
        %   xData, yData - Original data
        %   baselineFit - Unconstrained baseline
        %
        % Returns:
        %   constrainedBaseline - Baseline with polysome-specific constraints applied
        
        constrainedBaseline = baselineFit;
        
        % Constraint 1: Baseline should never exceed data values (rolling ball principle)
        constrainedBaseline = min(constrainedBaseline, yData);
        
        % Constraint 2: Handle the natural rise in heavy polysome region (typically 60-80mm)
        dataRange = max(xData) - min(xData);
        heavyPolysomeStart = min(xData) + 0.7 * dataRange; % Approximate 70% through column
        
        heavyRegion = xData >= heavyPolysomeStart;
        if any(heavyRegion)
            % Allow gradual increase in baseline for heavy polysome region
            heavyIndices = find(heavyRegion);
            startIdx = heavyIndices(1);
            
            if startIdx > 1
                % Ensure smooth transition into heavy region
                transitionValue = constrainedBaseline(startIdx-1);
                heavySlope = (constrainedBaseline(end) - transitionValue) / length(heavyIndices);
                
                % Apply gentle upward trend in heavy region
                for i = 1:length(heavyIndices)
                    idx = heavyIndices(i);
                    expectedValue = transitionValue + heavySlope * (i-1);
                    
                    % Don't force baseline above reasonable limits
                    maxAllowed = transitionValue + 0.1 * (max(yData) - min(yData));
                    constrainedBaseline(idx) = min(expectedValue, maxAllowed);
                end
            end
        end
        
        % Constraint 3: Handle negative values gracefully
        negativeIndices = yData < 0;
        if any(negativeIndices)
            % Allow baseline to go negative where data is negative
            constrainedBaseline(negativeIndices) = min(constrainedBaseline(negativeIndices), yData(negativeIndices));
        end
    end
    
