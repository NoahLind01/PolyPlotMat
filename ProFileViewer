        % Button pushed function: SaveAnalysisButton
        function SaveAnalysisButtonPushed(app, event)
            % Save current runoff analysis session
    
            if isempty(app.runoffAnalysisTable)
                warndlg('No analysis data to save.', 'No Data');
                return;
            end
            
            % Create filename based on project
            projectName = 'RunoffAnalysis';
            if ~isempty(app.runoffAnalysisTable) && height(app.runoffAnalysisTable) > 0
                firstProject = app.runoffAnalysisTable.Project{1};
                if ~isempty(firstProject)
                    projectName = firstProject;
                end
            end
            
            timestamp = datestr(now, 'yyyymmdd_HHMMSS');
            defaultName = sprintf('%s_Session_%s.mat', projectName, timestamp);
            
            [fileName, filePath] = uiputfile('*.mat', 'Save Analysis Session', defaultName);
            if isequal(fileName, 0), return; end
            
            % Save session data
            runoffData = struct();
            runoffData.analysisTable = app.runoffAnalysisTable;
            runoffData.ballRadius = app.BaslineballradiusEditField.Value;
            runoffData.sensitivity = app.PeakSensitivityEditField.Value;
            runoffData.savedOn = datestr(now);
            runoffData.version = 'V9';
            
            save(fullfile(filePath, fileName), 'runoffData');
            
            msgbox(sprintf('Analysis session saved: %s', fileName), 'Save Complete');
            fprintf('Saved runoff session: %d files analyzed\n', height(app.runoffAnalysisTable));
        end

