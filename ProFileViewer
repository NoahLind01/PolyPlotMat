    function ballRadius = calculateOptimalBallRadius(app, xData, yData)
        % Calculate more reasonable ball radius for polysome data
        
        if ~isempty(app.BallRadiusEditField.Value) && app.BallRadiusEditField.Value > 0
            ballRadius = app.BallRadiusEditField.Value;
            fprintf('  - Using user-defined ball radius: %.3f\n', ballRadius);
            return;
        end
        
        % For polysome data, use biological knowledge about peak spacing
        dataRange = max(xData) - min(xData);
        
        % Typical spacing between ribosome features is ~7-12mm
        % Ball radius should be smaller than this to detect valleys between peaks
        % But large enough to ignore noise within peaks
        
        peakWidths = app.estimatePeakWidths(xData, yData);
        
        if ~isempty(peakWidths)
            typicalPeakWidth = median(peakWidths);
            % Use 20% of peak width for more sensitive valley detection
            ballRadius = typicalPeakWidth * 0.2;
            fprintf('  - Based on peak width %.3f, using ball radius: %.3f\n', typicalPeakWidth, ballRadius);
        else
            % For polysome profiles, default to ~3-5mm ball radius
            ballRadius = min(5.0, dataRange * 0.06); % 6% of range or 5mm max
            fprintf('  - Using polysome-optimized default: %.3f\n', ballRadius);
        end
        
        % More reasonable bounds for polysome data
        minRadius = 0.5;  % 0.5mm minimum (was too small at 0.2)
        maxRadius = 20.0; % 20mm maximum (increased from 10)
        ballRadius = max(minRadius, min(maxRadius, ballRadius));
        
        app.BallRadiusEditField.Value = ballRadius;
        
        fprintf('  - Final ball radius: %.3f (bounds: %.1f to %.1f)\n', ballRadius, minRadius, maxRadius);
    end
    
    function peakWidths = estimatePeakWidths(app, xData, yData)
        % Estimate peak widths in the data
        %
        % Parameters:
        %   xData, yData - Input data
        %
        % Returns:
        %   peakWidths - Array of estimated peak widths
        
        try
            % Simple peak detection using MATLAB's findpeaks
            [peaks, peakLocs, peakWidths, peakProminences] = findpeaks(yData, xData, ...
                'MinPeakProminence', (max(yData) - min(yData)) * 0.1, ...
                'WidthReference', 'halfheight');
            
            % Filter peaks by prominence (only keep significant peaks)
            significantPeaks = peakProminences > (max(yData) - min(yData)) * 0.2;
            peakWidths = peakWidths(significantPeaks);
            
        catch
            % Fallback if findpeaks fails
            peakWidths = [];
        end
    end
    
    function distributedIndices = distributeBottomPoints(app, xData, yData, lowIndices, numSegments)
        % Distribute the lowest points across x-range
        
        xMin = min(xData);
        xMax = max(xData);
        segmentWidth = (xMax - xMin) / numSegments;
        
        distributedIndices = [];
        
        for seg = 1:numSegments
            segmentStart = xMin + (seg-1) * segmentWidth;
            segmentEnd = xMin + seg * segmentWidth;
            
            % Find low points in this segment
            segmentLowPoints = lowIndices(xData(lowIndices) >= segmentStart & ...
                                         xData(lowIndices) <= segmentEnd);
            
            if ~isempty(segmentLowPoints)
                % Pick the lowest point in this segment
                [~, lowestIdx] = min(yData(segmentLowPoints));
                distributedIndices = [distributedIndices; segmentLowPoints(lowestIdx)];
            end
        end
        
        % Always include the global minimum
        [~, globalMinIdx] = min(yData);
        distributedIndices = unique([distributedIndices; globalMinIdx]);
        
        % Sort by x-position
        [~, sortOrder] = sort(xData(distributedIndices));
        distributedIndices = distributedIndices(sortOrder);
    end
    
    function moreIndices = addMoreBaselinePoints(app, xData, currentIndices)
        % Add more baseline points if we have too few
        
        % Divide x-range into segments and ensure each has a baseline point
        numSegments = 8;
        xMin = min(xData);
        xMax = max(xData);
        segmentWidth = (xMax - xMin) / numSegments;
        
        moreIndices = currentIndices;
        
        for seg = 1:numSegments
            segmentStart = xMin + (seg-1) * segmentWidth;
            segmentEnd = xMin + seg * segmentWidth;
            
            % Check if this segment has any baseline points
            segmentIndices = currentIndices(xData(currentIndices) >= segmentStart & ...
                                           xData(currentIndices) <= segmentEnd);
            
            if isempty(segmentIndices)
                % Find the index closest to the middle of this segment
                segmentMiddle = (segmentStart + segmentEnd) / 2;
                [~, closestIdx] = min(abs(xData - segmentMiddle));
                moreIndices = [moreIndices; closestIdx];
            end
        end
        
        moreIndices = unique(moreIndices);
    end
    
    function filteredIndices = filterForDistribution(app, xData, baselineIndices)
        % Filter baseline points to ensure good distribution
        
        % Sort by x-coordinate
        [~, sortOrder] = sort(xData(baselineIndices));
        sortedIndices = baselineIndices(sortOrder);
        
        % Keep every nth point to ensure distribution
        if length(sortedIndices) > 20
            keepEvery = round(length(sortedIndices) / 15);
            filteredIndices = sortedIndices(1:keepEvery:end);
            
            % Always keep first and last points
            if ~ismember(sortedIndices(1), filteredIndices)
                filteredIndices = [sortedIndices(1); filteredIndices];
            end
            if ~ismember(sortedIndices(end), filteredIndices)
                filteredIndices = [filteredIndices; sortedIndices(end)];
            end
        else
            filteredIndices = sortedIndices;
        end
    end
    
    function [baselineFit, quality] = interpolateBaseline(~, xData, yData, baselinePoints, baselineIndices)
        % Interpolate baseline over full x-range using spline or robust method
        %
        % Parameters:
        %   xData, yData - Full data
        %   baselinePoints - Y-values of baseline points
        %   baselineIndices - Indices of baseline points
        %
        % Returns:
        %   baselineFit - Interpolated baseline over full x-range
        %   quality - Quality measure of the fit
        
        if length(baselineIndices) < 3
            % Fallback to linear fit for too few points
            p = polyfit(xData(baselineIndices), baselinePoints, 1);
            baselineFit = polyval(p, xData);
            quality = 0.5;
            return;
        end
        
        try
            % Use monotonic spline interpolation to preserve trends
            baselineFit = interp1(xData(baselineIndices), baselinePoints, xData, ...
                                 'pchip', 'extrap');
            
            % Ensure baseline doesn't go above any data points (rolling ball constraint)
            baselineFit = min(baselineFit, yData);
            
            % Calculate quality measure
            residuals = yData(baselineIndices) - baselineFit(baselineIndices);
            quality = 1 - (std(residuals) / std(yData));
            quality = max(0, min(1, quality)); % Bound between 0 and 1
            
        catch
            % Fallback to polynomial fit
            p = polyfit(xData(baselineIndices), baselinePoints, min(3, length(baselineIndices)-1));
            baselineFit = polyval(p, xData);
            quality = 0.3;
        end
    end
    

