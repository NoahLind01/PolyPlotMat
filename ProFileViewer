                app.TotalPolysomeAUCvsTime.YLim = aucYLim;
                
                hold(app.TotalPolysomeAUCvsTime, 'off');
                
                % PRESERVE or AUTO-SCALE X-axis for AUC plot
                if ~isempty(aucXLimManual)
                    app.TotalPolysomeAUCvsTime.XLim = aucXLimManual;
                    fprintf('  Applied manual AUC X-limits: [%.1f, %.1f]\n', aucXLimManual(1), aucXLimManual(2));
