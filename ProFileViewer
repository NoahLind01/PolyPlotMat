    function exportTable = expandRunoffTableForExport(app)
        % Expand storage table into exportable format with individual peak rows
        
        if isempty(app.runoffAnalysisTable)
            exportTable = table();
            return;
        end
        
        % Count total rows needed (sum of all peak counts)
        totalPeaks = sum(app.runoffAnalysisTable.PeakCount);
        
        if totalPeaks == 0
            % Create summary table if no individual peaks
            exportTable = app.runoffAnalysisTable;
            return;
        end
        
        % Pre-allocate expanded table
        filenames = cell(totalPeaks, 1);
        times = zeros(totalPeaks, 1);
        conditions = cell(totalPeaks, 1);
        projects = cell(totalPeaks, 1);
        peakNumbers = zeros(totalPeaks, 1);
        peakPositions = zeros(totalPeaks, 1);
        peakHeights = zeros(totalPeaks, 1);
        peakAUCs = zeros(totalPeaks, 1);
        totalAUCs = zeros(totalPeaks, 1);
        
        rowIndex = 1;
        
        % Expand each file's peaks into individual rows
        for fileIndex = 1:height(app.runoffAnalysisTable)
            filename = app.runoffAnalysisTable.Filename{fileIndex};
            time = app.runoffAnalysisTable.Time(fileIndex);
            condition = app.runoffAnalysisTable.Condition{fileIndex};
            project = app.runoffAnalysisTable.Project{fileIndex};
            totalAUC = app.runoffAnalysisTable.TotalAUC(fileIndex);
            
            positions = app.runoffAnalysisTable.PeakPositions{fileIndex};
            heights = app.runoffAnalysisTable.PeakHeights{fileIndex};
            aucs = app.runoffAnalysisTable.PeakAUCs{fileIndex};
            
            % Add row for each peak
            for peakIndex = 1:length(positions)
                filenames{rowIndex} = filename;
                times(rowIndex) = time;
                conditions{rowIndex} = condition;
                projects{rowIndex} = project;
                peakNumbers(rowIndex) = peakIndex;
                peakPositions(rowIndex) = positions(peakIndex);
                peakHeights(rowIndex) = heights(peakIndex);
                peakAUCs(rowIndex) = aucs(peakIndex);
                totalAUCs(rowIndex) = totalAUC;
                
                rowIndex = rowIndex + 1;
            end
        end
        
        % Create expanded table
        exportTable = table(filenames, times, conditions, projects, peakNumbers, ...
