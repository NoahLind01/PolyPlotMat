    function writeRunoffAnalysisCSV(app, exportTable, fullPath)
        % Write runoff analysis data to CSV with metadata header (fixed temp file handling)
        
        try
            % Create metadata header
            header = sprintf(['# Polysome Runoff Quantification Analysis\n', ...
                '# Generated: %s\n', ...
                '# Analysis Method: Curve Min Zero with islocalmax Peak Detection\n', ...
                '# Ball Radius: %.3f mm\n', ...
                '# Peak Detection Sensitivity: %.2f\n', ...
                '# Files Analyzed: %d\n', ...
                '# Total Peaks Detected: %d\n', ...
                '#\n'], ...
                datestr(now), ...
                app.BaslineballradiusEditField.Value, ...
                app.PeakSensitivityEditField.Value, ...
                height(app.runoffAnalysisTable), ...
                sum(app.runoffAnalysisTable.PeakCount));
            
            % Write table to temporary location (FIXED: specify file type)
            tempFile = [fullPath, '.tmp'];
            writetable(exportTable, tempFile, 'FileType', 'text', 'Delimiter', ',');
            
            % Read back and prepend header
            fileID = fopen(tempFile, 'r');
            tableContent = fread(fileID, '*char')';
            fclose(fileID);
            
            % Write final file with header
            fileID = fopen(fullPath, 'w');
            fprintf(fileID, '%s%s', header, tableContent);
            fclose(fileID);
            
            % Clean up temp file
            if exist(tempFile, 'file')
                delete(tempFile);
            end
            
            fprintf('Successfully wrote runoff analysis to: %s\n', fullPath);
            
        catch e
            fprintf('Error writing CSV: %s\n', E.message);
            % Fallback - write without header
            try
                writetable(exportTable, fullPath, 'FileType', 'text');
                fprintf('Fallback CSV write successful\n');
            catch e2
                fprintf('Fallback also failed: %s\n', e2.message);
            end
        end
    end

    function createAndExportTimeCourseChart(app, svgPath)
