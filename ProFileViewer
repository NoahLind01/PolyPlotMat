    function [baselinePoints, baselineIndices] = applyQuantileRollingBall(app, xData, yData, ballRadius, percentile)
        % Use MATLAB's islocalmin with more sensitive parameters
        
        fprintf('  - Using islocalmin for robust valley detection\n');
        
        % Step 1: Use islocalmin with ball radius influencing parameters
        minSeparation = ballRadius * 0.8; % Slightly smaller separation for more valleys
        
        % Make prominence more sensitive
        dataRange = max(yData) - min(yData);
        if ballRadius < 2.0
            minProminence = 0.002 * dataRange; % Much more sensitive
        elseif ballRadius < 10.0
            minProminence = 0.005 * dataRange; % More sensitive  
        else
            minProminence = 0.01 * dataRange;  % Still sensitive for large ball
        end
        
        fprintf('    Ball radius: %.3f → MinSeparation: %.3f, MinProminence: %.6f\n', ...
            ballRadius, minSeparation, minProminence);
        
        % Find local minima using MATLAB's optimized function
        [TF, prominence] = islocalmin(yData, 'SamplePoints', xData, ...
                                     'MinSeparation', minSeparation, ...
                                     'MinProminence', minProminence, ...
                                     'FlatSelection', 'center');
        
        localMinimaIndices = find(TF);
        
        fprintf('    islocalmin found: %d valleys\n', length(localMinimaIndices));
        
        % Debug: show what was found
        for i = 1:min(10, length(localMinimaIndices))
            idx = localMinimaIndices(i);
            fprintf('      Valley %d: X=%.3f, Y=%.6f, prominence=%.6f\n', ...
                i, xData(idx), yData(idx), prominence(idx));
        end
        
        % Step 2: If still too few valleys, be even more permissive
        if length(localMinimaIndices) < 6
            fprintf('    Too few valleys, trying very relaxed parameters...\n');
            
            [TF_relaxed] = islocalmin(yData, 'SamplePoints', xData, ...
                                     'MinSeparation', minSeparation * 0.3, ... % Much smaller separation
                                     'MinProminence', minProminence * 0.2, ... % Much smaller prominence  
                                     'FlatSelection', 'center');
            
            relaxedIndices = find(TF_relaxed);
            fprintf('    Ultra-relaxed islocalmin found: %d valleys\n', length(relaxedIndices));
            
            % Combine results
