    function generateFloorZeroBaseline(app, x_data, y_data)
        % Generate Floor Zero baseline - horizontal line at floor zero level
        
        zeroLevel = app.calculateFloorZero(y_data);
        baselineFit = ones(size(x_data)) * zeroLevel; % Horizontal line
        
        % Store baseline fit
        app.lastBaselineFit = struct();
        app.lastBaselineFit.x = x_data;
        app.lastBaselineFit.y = baselineFit;
        app.lastBaselineFit.method = 'Floor Zero';
        app.lastBaselineFit.zeroLevel = zeroLevel;
        app.lastBaselineFit.quality = 1.0; % Perfect horizontal line
        
        % Create dummy regions (just endpoints for display)
        app.lastBaselineFit.regions = struct('x', [x_data(1); x_data(end)], ...
                                            'y', [zeroLevel; zeroLevel]);
        
        fprintf('Floor Zero baseline: %.6f\n', zeroLevel);
    end
    
    function generateLocalMinZeroBaseline(app, x_data, y_data)
        % Generate Local Min Zero baseline
        
        if ~isempty(app.selectedPoints) && size(app.selectedPoints, 1) >= 2
            % Use selected region
            x_selected = app.selectedPoints(:,1);
            zeroLevel = app.calculateLocalMinZero(x_data, y_data, x_selected);
            
            % Show baseline only in selected region
            x_min_region = min(x_selected);
            x_max_region = max(x_selected);
            
            baselineFit = y_data; % Start with original data
            regionMask = x_data >= x_min_region & x_data <= x_max_region;
            baselineFit(regionMask) = zeroLevel; % Set baseline in selected region
            baselineFit(~regionMask) = NaN; % Hide baseline outside selected region
            
            fprintf('Local Min Zero baseline: %.6f (in selected region: %.1f to %.1f)\n', ...
                    zeroLevel, x_min_region, x_max_region);
        else
            % No points selected - use global minimum
            zeroLevel = min(y_data);
            baselineFit = ones(size(x_data)) * zeroLevel;
            
            fprintf('Local Min Zero baseline: %.6f (global minimum - no region selected)\n', zeroLevel);
        end
        
        % Store baseline fit
        app.lastBaselineFit = struct();
        app.lastBaselineFit.x = x_data;
        app.lastBaselineFit.y = baselineFit;
        app.lastBaselineFit.method = 'Local Min Zero';
        app.lastBaselineFit.zeroLevel = zeroLevel;
        app.lastBaselineFit.quality = 1.0;
        
        % Create regions for display
        if ~isempty(app.selectedPoints) && size(app.selectedPoints, 1) >= 2
            validIndices = ~isnan(baselineFit);
            app.lastBaselineFit.regions = struct('x', x_data(validIndices), ...
                                                'y', baselineFit(validIndices));
        else
            app.lastBaselineFit.regions = struct('x', [x_data(1); x_data(end)], ...
                                                'y', [zeroLevel; zeroLevel]);
        end
    end
    
    function generateCurveMinZeroBaseline(app, x_data, y_data)
        % Generate Curve Min Zero baseline using quantile rolling ball
        
        try
            % Use quantile rolling ball method
            percentile = app.determineOptimalPercentile(x_data, y_data);
            [baselineFit, baselineInfo] = app.quantileRollingBallBaseline(x_data, y_data, percentile);
            
            % Store baseline fit
            app.lastBaselineFit = struct();
            app.lastBaselineFit.x = x_data;
            app.lastBaselineFit.y = baselineFit;
            app.lastBaselineFit.regions = baselineInfo.baselineRegions;
            app.lastBaselineFit.quality = baselineInfo.quality;
            app.lastBaselineFit.method = 'Quantile Rolling Ball';
            app.lastBaselineFit.ballRadius = baselineInfo.ballRadius;
            app.lastBaselineFit.percentile = baselineInfo.percentile;
            
            fprintf('Curve Min Zero baseline: Quantile rolling ball (r=%.3f, p%d%%)\n', ...
                    baselineInfo.ballRadius, baselineInfo.percentile);
            
        catch e
            fprintf('Error generating Curve Min Zero baseline: %s\n', E.message);
            % Fallback to simple horizontal line
            app.generateFloorZeroBaseline(x_data, y_data);
        end
    end
    
