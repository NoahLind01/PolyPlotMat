    function zeroLevel = calculateZeroLevelGeneric(app, xData_unique, yData_unique, x_sorted, zeroingMethod)
        % Generic zero level calculation for backwards compatibility
        %
        % Parameters:
        %   xData_unique, yData_unique - Cleaned data
        %   x_sorted - Selected x points
        %   zeroingMethod - 'Floor', 'LocalMin', 'CurveMin', or 'Auto'
        %
        % Returns:
        %   zeroLevel - Calculated zero level
        
        switch zeroingMethod
            case 'Floor'
                zeroLevel = app.calculateFloorZero(yData_unique);
                
            case 'LocalMin'
                zeroLevel = app.calculateLocalMinZero(xData_unique, yData_unique, x_sorted);
                
            case 'CurveMin'
                zeroLevel = app.calculateCurveMinZero(xData_unique, yData_unique);
                
            case 'Auto'
                % Use existing logic from original calculateZeroLevel
                zeroLevel = app.calculateZeroLevel(xData_unique, yData_unique, x_sorted, yData_unique, xData_unique);
                
            otherwise
                % Default to Floor Zero
                zeroLevel = app.calculateFloorZero(yData_unique);
        end
    end

    function zeroLevel = calculateFloorZero(~, yData)
    % Calculate floor zero - uses true zero or minimum of data
    %
    % Parameters:
    %   yData - Y-axis data
    %
    % Returns:
    %   zeroLevel - The floor zero level
    
    minValue = min(yData);
    
    if minValue >= 0
        % All values are positive, use true zero
        zeroLevel = 0;
    else
        % Has negative values, use minimum as floor
        zeroLevel = minValue;
        end
    end

    function zeroLevel = calculateLocalMinZero(~, xData, yData, x_selected)
        % Calculate local minimum zero - minimum within selected region
        %
        % Parameters:
        %   xData - X-axis data
        %   yData - Y-axis data
        %   x_selected - Selected x points for AUC calculation
        %
        % Returns:
        %   zeroLevel - The local minimum zero level
        
        % Find the range of selected x values
        x_min_region = min(x_selected);
        x_max_region = max(x_selected);
        
        % Get all data points within the selected x range
        region_indices = xData >= x_min_region & xData <= x_max_region;
        y_in_region = yData(region_indices);
        
        if isempty(y_in_region)
            % Fallback to global minimum if no data in region
            zeroLevel = min(yData);
        else
            % Use minimum value within the selected region
            zeroLevel = min(y_in_region);
        end
    end

    function zeroLevel = calculateCurveMinZero(app, xData, yData)
        % Calculate curve minimum zero using quantile-based rolling ball baseline correction
        % Optimized for polysome profiling data
        %
        % Parameters:
        %   xData - X-axis data
        %   yData - Y-axis data
        %
        % Returns:
        %   zeroLevel - The curve minimum zero level based on quantile rolling ball baseline
        
        try
            % Determine percentile based on data characteristics
            percentile = app.determineOptimalPercentile(xData, yData);
            
            % Apply quantile-based rolling ball baseline correction
            [baselineFit, baselineInfo] = app.quantileRollingBallBaseline(xData, yData, percentile);
            
            % For polysome data, use a conservative minimum (not absolute minimum)
            % This handles the natural baseline rise better
            zeroLevel = prctile(baselineFit, 5); % 5th percentile of baseline, not absolute min
            
            fprintf('Curve Min Zero: Quantile rolling ball baseline correction completed\n');
            fprintf('  - Percentile used: %d%%\n', percentile);
            fprintf('  - Ball radius: %.3f\n', baselineInfo.ballRadius);
            fprintf('  - Baseline points used: %d\n', baselineInfo.numBaselinePoints);
            fprintf('  - Calculated zero level: %.6f (5th percentile of baseline)\n', zeroLevel);
            fprintf('  - Baseline range: %.6f to %.6f\n', min(baselineFit), max(baselineFit));
            
            % Store baseline fit for visualization
            app.lastBaselineFit = struct();
            app.lastBaselineFit.x = xData;
            app.lastBaselineFit.y = baselineFit;
            app.lastBaselineFit.regions = baselineInfo.baselineRegions;
            app.lastBaselineFit.quality = baselineInfo.quality;
            app.lastBaselineFit.method = 'Quantile Rolling Ball';
            app.lastBaselineFit.ballRadius = baselineInfo.ballRadius;
            app.lastBaselineFit.percentile = baselineInfo.percentile;
            
        catch e
            warning('Error in quantile rolling ball baseline correction: %s', E.message);
            fprintf('Curve Min Zero: Falling back to global minimum due to error\n');
            zeroLevel = min(yData);
        end
    end
    
