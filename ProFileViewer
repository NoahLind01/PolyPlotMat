    function saveCurrentFilePeaks(app)
        % Save current file's peaks with safe empty array handling
        
        currentFile = app.RQWorkspaceDropDown.Value;
        if strcmp(currentFile, "No Data")
            return;
        end
        
        peakCount = size(app.detectedPeaks, 1);
        fprintf('  Saving %d peaks for file: %s\n', peakCount, currentFile);
        
        % Calculate peak AUCs (safe for empty arrays)
        if peakCount > 0
            peakAUCs = app.calculateAllPeakAUCs();
        else
            peakAUCs = [];
            fprintf('  No peaks to calculate AUCs for\n');
        end
        
        % Create or find file entry
        if isempty(app.runoffAnalysisTable)
            fileIndex = 1;
            isNewFile = true;
        else
            fileIndex = find(strcmp(app.runoffAnalysisTable.Filename, currentFile));
            if isempty(fileIndex)
                fileIndex = height(app.runoffAnalysisTable) + 1;
                isNewFile = true;
            else
                isNewFile = false;
                fprintf('  Updating existing entry (index %d)\n', fileIndex);
            end
        end
        
        % Prepare data structure with EXPLICIT empty array handling
        newEntry = table();
        newEntry.Filename = {currentFile};
        newEntry.Time = app.currentRunoffMetadata.time;
        newEntry.Condition = {app.currentRunoffMetadata.condition};
        newEntry.Project = {app.currentRunoffMetadata.project};
        newEntry.PeakCount = peakCount;
        
        % SAFE empty array handling - explicitly check size
        if peakCount > 0 && size(app.detectedPeaks, 2) >= 2
            newEntry.PeakPositions = {app.detectedPeaks(:, 1)};
            newEntry.PeakHeights = {app.detectedPeaks(:, 2)};
        else
            % Explicitly create empty arrays of correct type
            newEntry.PeakPositions = {double.empty(0,1)};
            newEntry.PeakHeights = {double.empty(0,1)};
        end
        
        newEntry.PeakAUCs = {peakAUCs};
        newEntry.TotalAUC = sum(peakAUCs);
        
        % Add to table
        if isNewFile
            if isempty(app.runoffAnalysisTable)
                app.runoffAnalysisTable = newEntry;
            else
                app.runoffAnalysisTable = [app.runoffAnalysisTable; newEntry];
            end
            fprintf('  Added new file entry (index %d)\n', fileIndex);
        else
            % Update existing entry
            app.runoffAnalysisTable(fileIndex, :) = newEntry;
        end
        
        app.currentFileIndex = fileIndex;
        app.updateRunoffResultsTable();
        
        % AUTO-UPDATE built-in charts whenever data changes
        if height(app.runoffAnalysisTable) >= 1
            app.updateBuiltInTimeCharts();
        end
        
        fprintf('  Storage updated: %d peaks, Total AUC: %.6f\n', peakCount, sum(peakAUCs));
    end
    
