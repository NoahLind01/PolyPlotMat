    function debugZeroingMethods(app)
        % Debug what each zeroing method calculates for current data
        
        value = app.APWorkspaceDropDown.Value;
        if strcmp(value, "No Data")
            fprintf('No data loaded for zeroing method debug\n');
            return;
        end
        
        selectedIndex = find(strcmp(app.workspace(:,1), [value, '.csv']));
        if isempty(selectedIndex)
            fprintf('Selected file not found in workspace\n');
            return;
        end
        
        selectedFile = app.workspace{selectedIndex, 2};
        
        try
            % Get data
            x_data = app.getPositionData(selectedFile);
            currentChannel = app.ChannelDropDown_2.Value;
            if strcmp(currentChannel, "No Data") || ~ismember(currentChannel, selectedFile.Properties.VariableNames)
                currentChannel = app.getDefaultChannel(selectedFile.Properties.VariableNames, {'AbsA', 'Absorbance'});
            end
            y_data = selectedFile.(currentChannel);
            
            % Get selected points if any
            if ~isempty(app.selectedPoints)
                x_selected = app.selectedPoints(:,1);
            else
                fprintf('No points selected - using full data range for comparison\n');
                x_selected = [min(x_data); max(x_data)];
            end
            
            fprintf('\n=== ZEROING METHODS DEBUG ===\n');
            fprintf('Data range: X[%.2f to %.2f], Y[%.6f to %.6f]\n', ...
                min(x_data), max(x_data), min(y_data), max(y_data));
            
            if ~isempty(app.selectedPoints)
                fprintf('Selected region: X[%.2f to %.2f]\n', min(x_selected), max(x_selected));
            end
            
            % Test Floor Zero with proper MATLAB syntax
            floorZero = app.calculateFloorZero(y_data);
            fprintf('\n1. FLOOR ZERO: %.6f\n', floorZero);
            if min(y_data) >= 0
                logicText = 'true zero (0)';
            else
                logicText = 'minimum as floor';
            end
            fprintf('   Logic: min(yData)=%.6f, using %s\n', min(y_data), logicText);
            
            % Test Local Min Zero
            localMinZero = app.calculateLocalMinZero(x_data, y_data, x_selected);
            fprintf('\n2. LOCAL MIN ZERO: %.6f\n', localMinZero);
            if ~isempty(app.selectedPoints)
                x_min_region = min(x_selected);
                x_max_region = max(x_selected);
                region_indices = x_data >= x_min_region & x_data <= x_max_region;
                y_in_region = y_data(region_indices);
                fprintf('   Logic: min in region [%.2f,%.2f] = %.6f\n', ...
                    x_min_region, x_max_region, min(y_in_region));
            else
                fprintf('   Logic: no selection, using global min = %.6f\n', min(y_data));
            end
            
            % Test Curve Min Zero with enhanced debugging
            fprintf('\n3. CURVE MIN ZERO:\n');
            try
                fprintf('   Calling calculateCurveMinZero...\n');
                curveMinZero = app.calculateCurveMinZero(x_data, y_data);
                fprintf('   Final result: %.6f\n', curveMinZero);
                
                % Check if baseline fit was actually created
                if ~isempty(app.lastBaselineFit) && isfield(app.lastBaselineFit, 'method')
                    fprintf('   Baseline fit method: %s\n', app.lastBaselineFit.method);
                    if isfield(app.lastBaselineFit, 'y')
                        fprintf('   Baseline range: %.6f to %.6f\n', min(app.lastBaselineFit.y), max(app.lastBaselineFit.y));
                        fprintf('   5th percentile of baseline: %.6f\n', prctile(app.lastBaselineFit.y, 5));
                    end
                else
                    fprintf('   WARNING: No baseline fit stored!\n');
                end
                
            catch e
                fprintf('   ERROR in Curve Min Zero: %s\n', E.message);
                fprintf('   This explains why Floor and Curve are identical!\n');
                curveMinZero = NaN;
            end
            
            fprintf('\n=== COMPARISON ===\n');
            fprintf('Floor Zero:     %.6f\n', floorZero);
            fprintf('Local Min Zero: %.6f\n', localMinZero);  
            fprintf('Curve Min Zero: %.6f\n', curveMinZero);
            fprintf('Differences:\n');
            fprintf('  Floor vs Local: %.6f\n', abs(floorZero - localMinZero));
            if ~isnan(curveMinZero)
                fprintf('  Floor vs Curve: %.6f\n', abs(floorZero - curveMinZero));
                fprintf('  Local vs Curve: %.6f\n', abs(localMinZero - curveMinZero));
            else
                fprintf('  Floor vs Curve: CANNOT COMPARE (Curve failed)\n');
            end
            
            if ~isnan(curveMinZero) && abs(floorZero - curveMinZero) < 1e-6
                fprintf('\nISSUE IDENTIFIED: Floor and Curve methods returning nearly identical values!\n');
                fprintf('This suggests:\n');
                fprintf('  1. Curve Min baseline is very flat/low\n');
                fprintf('  2. Data minimum ≈ baseline 5th percentile\n');
                fprintf('  3. Baseline calculation may be falling back to global minimum\n');
            elseif isnan(curveMinZero)
                fprintf('\nISSUE IDENTIFIED: Curve Min Zero is FAILING and falling back!\n');
                fprintf('Check the quantileRollingBallBaseline method for errors.\n');
            end
            
            fprintf('=== END DEBUG ===\n\n');
            
        catch e
            fprintf('Error in zeroing methods debug: %s\n', E.message);
        end
    end

