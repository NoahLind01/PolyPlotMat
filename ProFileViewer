        % Button down function: AnalysisPanel
        function AnalysisPanelButtonDown(app, event)
            % Preserve existing plot state when switching to Analysis Panel
    
            % Update workspace dropdown items
            app.APWorkspaceDropDown.Items = app.WorkspaceDropDown.Items;
            
            value = app.APWorkspaceDropDown.Value;
            
            if ~strcmp(value, "No Data")
                % Find the corresponding index in the workspace
                selectedIndex = find(strcmp(app.workspace(:,1), [value, '.csv']));
                
                if ~isempty(selectedIndex)
                    % Get the selected file data
                    selectedFile = app.workspace{selectedIndex, 2};
                    
                    % UPDATE DROPDOWN ITEMS FIRST
                    availableChannels = selectedFile.Properties.VariableNames;
                    app.ChannelDropDown_2.Items = availableChannels;
                    
                    % ALWAYS prefer Absorbance on Analysis Panel (don't preserve previous selection)
                    channelToPlot = app.getDefaultChannel(availableChannels, {'Absorbance', 'AbsA'});
                    app.ChannelDropDown_2.Value = channelToPlot;
                    fprintf("Analysis panel channel set to: %s (always prefer Absorbance)\n", channelToPlot);
            
            % Check if we need to refresh the main data line
            currentPlotChildren = get(app.APPlot, 'Children');
            hasMainDataLine = false;
            
            % Look for existing main data line (non-baseline, non-marker line)
            for i = 1:length(currentPlotChildren)
                obj = currentPlotChildren(i);
                if isa(obj, 'matlab.graphics.chart.primitive.Line') && ...
                   strcmp(obj.Marker, 'none') && ...
                   ~contains(obj.DisplayName, 'Baseline') && ...
                   ~contains(obj.DisplayName, 'Zero') && ...
                   strcmp(obj.LineStyle, '-')
                    hasMainDataLine = true;
                    break;
                end
            end
            
            % Only refresh if we don't have a main data line
            needsRefresh = ~hasMainDataLine;
            
            if needsRefresh
                fprintf('Refreshing Analysis Panel (preserving baseline and selections)\n');
                
                % Get data
                try
                    x_data = app.getPositionData(selectedFile);
                    y_data = selectedFile.(channelToPlot);
                    
                    % Remove ONLY the main data line, preserve everything else
                    existingLines = findobj(app.APPlot, 'Type', 'line');
                    for i = 1:length(existingLines)
                        if strcmp(existingLines(i).Marker, 'none') && ...
                           ~contains(existingLines(i).DisplayName, 'Baseline') && ...
                           ~contains(existingLines(i).DisplayName, 'Zero') && ...
                           strcmp(existingLines(i).LineStyle, '-') && ...
                           length(existingLines(i).Color) == 3 && ...
                           all(existingLines(i).Color == [0 0 0]) % Black main data line
                            delete(existingLines(i));
                            fprintf('  - Removed old main data line\n');
                        end
                    end
                    
                    % Add new main data line while preserving other elements
                    hold(app.APPlot, 'on');
                    mainDataLine = plot(app.APPlot, x_data, y_data, '-k', 'LineWidth', 1);
                    mainDataLine.DisplayName = 'Data';
                    mainDataLine.Annotation.LegendInformation.IconDisplayStyle = 'off'; % Don't show in legend
                    
                    % Set labels and title
                    xlabel(app.APPlot, 'Distance');
                    ylabel(app.APPlot, channelToPlot);
                    title(app.APPlot, ['Data from ', strrep(value, '_', ' ')]);
                    
                    % Apply autoscaling if enabled and no baseline is shown
                    if strcmp(app.AutoscaleSwitch.Value, "On") && ...
                       (~app.VisualizeBaselineButton.Value || isempty(app.lastBaselineFit))
                        newAxis = app.autoScalePlot(x_data, y_data);
                        app.APPlot.YLim = newAxis;
                    end
                    
                    hold(app.APPlot, 'off');
                    
                    fprintf('  - Main data refreshed: %s channel\n', channelToPlot);
                    fprintf('  - Preserved baseline: %s\n', string(app.VisualizeBaselineButton.Value));
                    if ~isempty(app.selectedPoints)
                        fprintf('  - Preserved selection: %d points\n', size(app.selectedPoints, 1));
                    else
                        fprintf('  - No selection to preserve\n');
                    end
                    
                catch e
                    fprintf('Error refreshing plot: %s\n', E.message);
                    % Fallback to original behavior if there's an error
                    try
                        app.plotWorkspaceFiles(selectedFile, channelToPlot, value);
                    catch e2
                        fprintf('Fallback also failed: %s\n', e2.message);
                    end
                end
            else
                fprintf('Analysis Panel: Plot already current (no refresh needed)\n');
                
                % Update title in case filename changed
                try
                    title(app.APPlot, ['Data from ', strrep(value, '_', ' ')]);
                catch
                    % Continue if title update fails
                end
            end
            
        else
            fprintf('Selected file not found in workspace\n');
        end
    else
        fprintf('No data selected for Analysis Panel\n');
    end
        end

