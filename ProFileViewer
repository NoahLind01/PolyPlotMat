                % Force visual refresh
                drawnow;
                
                fprintf('Built-in time course plots updated: %d conditions (%s scale)\n', length(conditions), timeUnit);
                fprintf('  Y-axis scaling: Polysome[0,%.1f], AUC[0,%.4f]\n', polyYLim(2), aucYLim(2));
                
            catch e
                fprintf('Error updating time course plots: %s\n', E.message);
            end
        end

        % Button pushed function: ExportRunoffButton
        function ExportRunoffButtonPushed(app, event)
            % Export runoff analysis data AND create publication-ready SVG figures
    
            if isempty(app.runoffAnalysisTable)
                warndlg('No analysis data to export.', 'No Data');
                return;
            end
            
            % Get export location
            timestamp = datestr(now, 'yyyymmdd_HHMMSS');
            
            projectName = 'RunoffAnalysis';
            if height(app.runoffAnalysisTable) > 0
                firstProject = app.runoffAnalysisTable.Project{1};
                if ~isempty(firstProject)
                    projectName = firstProject;
                end
            end
            
            defaultName = sprintf('%s_Export_%s', projectName, timestamp);
            
            [fileName, filePath] = uiputfile('*.csv', 'Export Runoff Analysis', [defaultName, '.csv']);
            if isequal(fileName, 0), return; end
            
            [~, baseName, ~] = fileparts(fileName);
            
            try
                fprintf('Exporting runoff analysis...\n');
                
                % 1. Export CSV data
                exportTable = app.expandRunoffTableForExport();
                csvPath = fullfile(filePath, fileName);
                app.writeRunoffAnalysisCSV(exportTable, csvPath);
                fprintf('  ✓ CSV data exported: %s\n', fileName);
                
                % 2. Create and export publication-ready SVG figure
                figPath = fullfile(filePath, [baseName, '_TimeCourse.svg']);
                app.createAndExportTimeCourseChart(figPath);
                fprintf('  ✓ SVG figure exported: %s\n', [baseName, '_TimeCourse.svg']);
                
                % 3. Export summary statistics
                summaryPath = fullfile(filePath, [baseName, '_Summary.txt']);
                app.exportRunoffSummaryStats(summaryPath);
                fprintf('  ✓ Summary statistics: %s\n', [baseName, '_Summary.txt']);
                
                % Show success message
                msgbox(sprintf('Complete runoff analysis exported:\n• Data: %s\n• Charts: %s\n• Summary: %s', ...
                    fileName, [baseName, '_TimeCourse.svg'], [baseName, '_Summary.txt']), ...
                    'Export Complete');
                
            catch e
                errordlg(sprintf('Error during export: %s', E.message), 'Export Error');
                fprintf('Export error: %s\n', E.message);
            end
        end

