        %   xClean, yClean - Cleaned data
        
        % Remove NaN values
        validIdx = ~isnan(xData) & ~isnan(yData);
        xClean = xData(validIdx);
        yClean = yData(validIdx);
        
        % Remove duplicates and sort
        [xClean, uniqueIdx] = unique(xClean);
        yClean = yClean(uniqueIdx);
        
        % Ensure we have enough data points
        if length(xClean) < 10
            error('Insufficient data points for baseline correction');
