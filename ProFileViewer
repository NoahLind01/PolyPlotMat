        % Value changed function: RunoffTimeEditField
        function RunoffTimeEditFieldValueChanged(app, event)
            % Handle manual time override
    
            newTimeString = app.RunoffTimeEditField.Value;
            
            if isempty(newTimeString)
                return;
            end
            
            try
                % Parse the time value (handle formats like "16.0min", "240s", "4.5")
                timePattern = '([0-9.]+)\s*([a-z]*)';
                tokens = regexp(newTimeString, timePattern, 'tokens');
                
                if ~isempty(tokens)
                    timeValue = str2double(tokens{1}{1});
                    timeUnit = tokens{1}{2};
                    
                    % Convert to current timescale if unit specified
                    if ~isempty(timeUnit)
                        if (contains(timeUnit, 'm') && ~app.MinutesButton.Value)
                            % User entered minutes but we're in seconds mode
                            timeValue = timeValue * 60;
                            fprintf('  Converted entered time: %s -> %.1fs\n', newTimeString, timeValue);
                        elseif (contains(timeUnit, 's') && app.MinutesButton.Value)
                            % User entered seconds but we're in minutes mode
                            timeValue = timeValue / 60;
                            fprintf('  Converted entered time: %s -> %.1fmin\n', newTimeString, timeValue);
                        end
                    else
                        % No unit specified - use as-is in current timescale
                        fprintf('  Using entered time as-is: %.1f\n', timeValue);
                    end
                    
                    % Update current metadata
                    if ~isempty(app.currentRunoffMetadata)
                        oldTime = app.currentRunoffMetadata.time;
                        app.currentRunoffMetadata.time = timeValue;
                        
                        fprintf('  Time manually changed: %.1f -> %.1f\n', oldTime, timeValue);
                        
                        % Update plot title
                        currentFile = app.RQWorkspaceDropDown.Value;
                        if ~strcmp(currentFile, "No Data")
                            if app.MinutesButton.Value
                                displayUnit = 'min';
                            else
                                displayUnit = 's';
                            end
                            
                            title(app.RQPlot, sprintf('%s (%.1f %s %s)', ...
                                strrep(currentFile, '_', ' '), ...
                                timeValue, displayUnit, ...
                                app.currentRunoffMetadata.condition));
                        end
                        
                        % Update storage if peaks exist
                        if ~isempty(app.detectedPeaks) && ~strcmp(currentFile, "No Data")
                            fprintf('  Updating storage with new time\n');
                            app.saveCurrentFilePeaks();
                            app.updateRunoffResultsTable();
                            
                            % Update charts (time axis will change)
                            if height(app.runoffAnalysisTable) >= 1
                                app.ViewRunoffDataButtonPushed(struct());
                            end
                        end
                    end
                    
                else
                    fprintf('  Could not parse time from: %s\n', newTimeString);
                end
                
            catch e
                fprintf('  Error parsing manual time entry: %s\n', E.message);
            end
            
        end

