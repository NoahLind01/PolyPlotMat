    function listing = changeDirectory(~, shouldChange)
        % Changes working directory and returns CSV files in the directory
        % 
        % Parameters:
        %   shouldChange - Boolean indicating whether to prompt for directory change
        %
        % Returns:
        %   listing - Cell array of CSV filenames in the directory
        
        if shouldChange
            newDir = uigetdir;
            if newDir ~= 0  % User didn't cancel
                cd(newDir);
            end
        end
        
        dirStruct = dir('*.csv');
        listing = {dirStruct.name};
    end
    
    function trimmedFile = trimFile(app, inputFile)
        % Reads CSV file and trims to relevant data rows
        %
        % Parameters:
        %   inputFile - Path to CSV file
        %
        % Returns:
        %   trimmedFile - MATLAB table with relevant data
        
        % Clean CSV file first
        cleanedFile = app.checkAndCleanCSV(inputFile);

        data = readtable(cleanedFile);
        startRow = find(strcmp(data.Properties.VariableNames, 'SampleA'));
        
        if ~isempty(startRow)
            trimmedFile = data(startRow:end, :);
        else
            trimmedFile = data;
        end
    end

    function cleanedFilePath = checkAndCleanCSV(app, inputFilePath)
        % Check and clean CSV file of Excel-added trailing commas
        %
        % Parameters:
        %   inputFilePath - Path to potentially corrupted CSV file
        %
        % Returns:
        %   cleanedFilePath - Path to cleaned CSV file (same as input if no changes needed)
        
        try
            % Read file as text lines
            fileID = fopen(inputFilePath, 'r');
            if fileID == -1
                error('Cannot open file: %s', inputFilePath);
            end
            
            lines = {};
            lineCount = 0;
            while ~feof(fileID)
                lineCount = lineCount + 1;
                lines{lineCount} = fgetl(fileID);
            end
            fclose(fileID);
            
            % Check for trailing commas and clean
            hasTrailingCommas = false;
            cleanedLines = lines;
            
            for i = 1:length(lines)
                line = lines{i};
                if ischar(line) && length(line) > 0
                    % Remove trailing commas
                    while length(line) > 0 && line(end) == ','
                        line = line(1:end-1);
                        hasTrailingCommas = true;
                    end
                    cleanedLines{i} = line;
                end
            end
            
            % Write cleaned file if changes were made
            if hasTrailingCommas
                fileID = fopen(inputFilePath, 'w');
                if fileID == -1
                    error('Cannot write cleaned file: %s', inputFilePath);
                end
                
                for i = 1:length(cleanedLines)
                    if i < length(cleanedLines)
                        fprintf(fileID, '%s\n', cleanedLines{i});
                    else
                        fprintf(fileID, '%s', cleanedLines{i}); % No newline on last line
                    end
                end
                fclose(fileID);
                
                fprintf('CSV file cleaned: removed Excel trailing commas from %s\n', inputFilePath);
            end
            
            cleanedFilePath = inputFilePath;
            
        catch e
            warning('Error cleaning CSV file %s: %s', inputFilePath, e.message);
            cleanedFilePath = inputFilePath; % Return original path if cleaning fails
        end
    end

    function metadata = parseRunoffFilename(app, filename)
        % Protein/gene-aware filename parsing that preserves biological names
        
        % Initialize metadata
        metadata = struct('filename', filename, 'time', 0, 'condition', '', 'project', '');
        
        try
            [~, basename, ~] = fileparts(filename);
            
            % Parse project (everything before first underscore)
            underscoreIdx = strfind(basename, '_');
            if ~isempty(underscoreIdx)
                metadata.project = basename(1:underscoreIdx(1)-1);
            end
            
            % Biological naming-aware patterns
            biologicalPatterns = {
                '(\d+)m([A-Za-z]+\d+)',         ... 4mRPL37, 8mRPS19 (minutes)
                '(\d+)min([A-Za-z]+\d+)',       ... 4minRPL37 (minutes)
                '(\d+)s([A-Za-z]+\d+)',         ... 240sRPL37 (seconds)
                '(\d+)sec([A-Za-z]+\d+)',       ... 240secRPL37 (seconds)
                '(\d+)m([A-Za-z]+)',            ... 4mScr, 4mCtrl (minutes, no numbers)
                '(\d+)min([A-Za-z]+)',          ... 4minScr (minutes, no numbers)
                '(\d+)s([A-Za-z]+)',            ... 240sScr (seconds, no numbers)
                '(\d+)sec([A-Za-z]+)',          ... 240secScr (seconds, no numbers)
                '(\d+)_([A-Za-z]+\d*)',         ... 4_RPL37, 4_Scr (user setting)
            };
            
            timeFound = false;
            
            for i = 1:length(biologicalPatterns)
                tokens = regexp(basename, biologicalPatterns{i}, 'tokens');
                if ~isempty(tokens)
                    timeValue = str2double(tokens{1}{1});
                    rawCondition = tokens{1}{2};
                    
                    % Determine time unit from pattern
                    if i <= 2 || i == 5 || i == 6  % Minutes patterns
                        detectedUnit = 'min';
                    elseif i <= 4 || i == 7 || i == 8  % Seconds patterns  
                        detectedUnit = 'sec';
                    else  % Ambiguous patterns
                        detectedUnit = 'unknown';
                    end
                    
                    % Apply user's timescale preference
                    if app.MinutesButton.Value
                        if strcmp(detectedUnit, 'sec')
                            metadata.time = timeValue / 60;
                            fprintf('  Converted %ds -> %.1fmin\n', timeValue, metadata.time);
                        else
                            metadata.time = timeValue;
                        end
                    else
                        if strcmp(detectedUnit, 'min')
                            metadata.time = timeValue * 60;
                            fprintf('  Converted %dmin -> %.0fs\n', timeValue, metadata.time);
                        else
                            metadata.time = timeValue;
                        end
                    end
                    
                    % PRESERVE condition exactly as found (including numbers!)
                    metadata.condition = rawCondition;
                    
                    timeFound = true;
                    fprintf('  Pattern match %d: time=%d%s, condition="%s"\n', ...
                        i, timeValue, detectedUnit, rawCondition);
                    break;
                end
            end
            
            % Fallback if no pattern matched
            if ~timeFound
                metadata.time = 0;
                metadata.condition = 'Unknown';
                fprintf('  Warning: Could not parse time/condition from filename\n');
            end
            
            % Final validation (minimal cleanup)
            if isempty(metadata.condition)
                metadata.condition = 'Unknown';
            end
            
            % Display result
            if app.MinutesButton.Value
                timeUnit = 'min';
            else
                timeUnit = 's';
            end
            
            fprintf('  Final: Time=%.1f%s, Condition="%s", Project="%s"\n', ...
                metadata.time, timeUnit, metadata.condition, metadata.project);
            
        catch e
            fprintf('  Error parsing filename: %s\n', E.message);
            metadata.time = 0;
            metadata.condition = 'Unknown';
        end
    end
    
