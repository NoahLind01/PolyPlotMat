        % Selection changed function: TimescaleButtonGroup
        function TimescaleButtonGroupSelectionChanged(app, event)
            % Handle timescale button change and reprocess all data
    
            selectedButton = event.NewValue;
            newTimeUnit = selectedButton.Text;
            
            fprintf('Timescale changed to: %s\n', newTimeUnit);
            
            % Get short unit for labels
            if app.MinutesButton.Value
                shortUnit = 'min';
                longUnit = 'minutes';
            else
                shortUnit = 's';
                longUnit = 'seconds';
            end
            
            % Update axis labels immediately
            app.updateRunoffAxisLabels();
            
            % Reprocess ALL stored files with new timescale
            if ~isempty(app.runoffAnalysisTable)
                fprintf('Reprocessing %d files with new timescale...\n', height(app.runoffAnalysisTable));
                
                % Store current file to reload after reprocessing
                currentFile = app.RQWorkspaceDropDown.Value;
                
                % Reprocess each file's metadata
                for i = 1:height(app.runoffAnalysisTable)
                    filename = app.runoffAnalysisTable.Filename{i};
                    newMetadata = app.parseRunoffFilename(filename);
                    
                    % Update stored metadata
                    app.runoffAnalysisTable.Time(i) = newMetadata.time;
                    fprintf('  %s: %.1f%s\n', filename, newMetadata.time, shortUnit);
                end
                
                % Update results table and charts
                app.updateRunoffResultsTable();
                
                % If we have data, refresh the charts with new units
                if height(app.runoffAnalysisTable) >= 1
                    app.ViewRunoffDataButtonPushed(struct());
                end
                
                % Reload current file's metadata display
                if ~strcmp(currentFile, "No Data")
                    app.currentRunoffMetadata = app.parseRunoffFilename(currentFile);
                    
                    % Update time display field safely
                    try
                        timeString = sprintf('%.1f%s', app.currentRunoffMetadata.time, shortUnit);
                        if isprop(app, 'RunoffTimeEditField')
                            app.RunoffTimeEditField.Value = timeString;
                        elseif isprop(app, 'RunoffTimeTextArea')
                            app.RunoffTimeEditField.Value = timeString;
                        end
                    catch
                        fprintf('  Could not update time display field\n');
                    end
                    
                    % Update current plot title
                    try
                        title(app.RQPlot, sprintf('%s (%.1f %s %s)', ...
                            strrep(currentFile, '_', ' '), ...
                            app.currentRunoffMetadata.time, ...
                            shortUnit, ...
                            app.currentRunoffMetadata.condition));
                    catch
                        fprintf('  Could not update main plot title\n');
                    end
                end
                
                fprintf('All files reprocessed for %s timescale\n', longUnit);
            else
                fprintf('No files to reprocess - axis labels updated only\n');
            end
            
        
        end

        % Button pushed function: ClearTableButton
        function ClearTableButtonPushed(app, event)
            % Clear ALL runoff analysis data from memory and UI
    
            if isempty(app.runoffAnalysisTable)
                fprintf('Runoff table already empty\n');
                return;
            end
            
            % Confirm with user
            choice = questdlg('Clear ALL runoff analysis data? This cannot be undone.', ...
                'Clear All Data', 'Yes', 'No', 'No');
            
            if strcmp(choice, 'Yes')
                fprintf('=== CLEARING ALL RUNOFF DATA ===\n');
                
                % Clear storage table completely
                app.runoffAnalysisTable = table();
                app.initializeRunoffStorage(); % Reset with proper structure
                
                % Clear current file data
                app.detectedPeaks = [];
                app.peakLabels = [];
                app.currentFileIndex = 0;
                app.currentRunoffMetadata = struct();
                
                % Clear UI table
                app.RunoffResultsTable.Data = {};
                app.RunoffResultsTable.ColumnName = {'File', 'Time', 'Condition', 'Peaks', 'Total AUC'};
                
                % Clear time course plots
                cla(app.PolysomePeakCountvsTime);
                cla(app.TotalPolysomeAUCvsTime);
                app.updateRunoffAxisLabels(); % Restore proper labels
                
                % Clear current plot peaks
                app.clearDetectedPeaks();
                
                % Update peak count display
                app.updatePeakCountDisplay();
                
                fprintf('All runoff data cleared from memory and UI\n');
                msgbox('All runoff analysis data has been cleared.', 'Data Cleared');
            else
                fprintf('Clear operation cancelled\n');
            end
        end

