    function peakAUCs = calculateAllPeakAUCs(app)
        % Calculate AUC for each detected peak with enhanced error handling
    
        if isempty(app.detectedPeaks)
            peakAUCs = [];
            return;
        end
        
        try
            % Ensure detectedPeaks is proper numeric array
            if iscell(app.detectedPeaks)
                app.detectedPeaks = cell2mat(app.detectedPeaks);
            end
            
            % Get current data
            selectedIndex = find(strcmp(app.workspace(:,1), [app.RQWorkspaceDropDown.Value, '.csv']));
            if isempty(selectedIndex)
                fprintf('Error: File not found in workspace\n');
                peakAUCs = zeros(size(app.detectedPeaks, 1), 1);
                return;
            end
            
            selectedFile = app.workspace{selectedIndex, 2};
            
            x_data = app.getPositionData(selectedFile);
            y_data = selectedFile.(app.RQChannelDropDown.Value);
            
            peakAUCs = zeros(size(app.detectedPeaks, 1), 1);
            
            fprintf('  Calculating AUCs for %d peaks...\n', size(app.detectedPeaks, 1));
            
            % Calculate AUC for each peak
            for i = 1:size(app.detectedPeaks, 1)
                try
                    peakX = app.detectedPeaks(i, 1);
                    
                    % Find boundaries using valleys on either side
                    [peakStart, peakEnd] = app.findPeakBoundariesByValleys(x_data, y_data, peakX);
                    
                    % Use generic AUC method with Curve Min Zero (good for peaks)
                    [peakAUC, ~] = app.calculateRegionAUC(x_data, y_data, [peakStart, peakEnd], 'CurveMin', app.RQChannelDropDown.Value);
                    
                    peakAUCs(i) = peakAUC;
                    fprintf('    Peak %d: AUC=%.6f (%.2f to %.2f mm, width=%.2f)\n', ...
                        i, peakAUC, peakStart, peakEnd, peakEnd - peakStart);
                    
                catch e
                    fprintf('    Error calculating AUC for peak %d: %s\n', i, E.message);
                    peakAUCs(i) = 0;
                end
            end
            
            fprintf('  Total peak AUCs: %.6f\n', sum(peakAUCs));
            
        catch e
            fprintf('Error calculating peak AUCs: %s\n', E.message);
            % Return safe default
            if ~isempty(app.detectedPeaks)
                peakAUCs = zeros(size(app.detectedPeaks, 1), 1);
            else
                peakAUCs = [];
            end
        end
    end

    

    function zeroLevel = calculateZeroLevel(app, xData_unique, yData_unique, x_sorted, yData_orig, xData_orig)
        % Calculate the zero level based on the selected zeroing method
        %
        % Parameters:
        %   xData_unique - Cleaned x-axis data
        %   yData_unique - Cleaned y-axis data
        %   x_sorted - Selected x points (sorted)
