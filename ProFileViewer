    function calculateAreaUnderCurve(app)
        % Calculates area under curve for absorbance and all fluorescence channels
        
        if numel(app.selectedPoints) < 2
            warndlg('Please select at least two points.', 'Warning');
            return;
        end
        
        x_selected = app.selectedPoints(:,1);
        
        % Get the current file data from workspace
        value = app.APWorkspaceDropDown.Value;
        if strcmp(value, "No Data")
            warndlg('No data selected for analysis.', 'Warning');
            return;
        end
        
        selectedIndex = find(strcmp(app.workspace(:,1), [value, '.csv']));
        if isempty(selectedIndex)
            warndlg('Selected file not found in workspace.', 'Warning');
            return;
        end
        
        selectedFile = app.workspace{selectedIndex, 2};
        
        % Get position data for analysis
        try
            x_data = app.getPositionData(selectedFile);
        catch
            warndlg('Could not find position data.', 'Warning');
            return;
        end
        
        % Find absorbance channel
        absChannel = '';
        if ismember('AbsA', selectedFile.Properties.VariableNames)
            absChannel = 'AbsA';
        elseif ismember('Absorbance', selectedFile.Properties.VariableNames)
            absChannel = 'Absorbance';
        end
        
        % Find all fluorescence channels
        fluoroChannels = struct();
        fluoroTypes = {'SampleFluorA', 'SampleFluorB', 'Fluorescence'};
        
        for i = 1:length(fluoroTypes)
            if ismember(fluoroTypes{i}, selectedFile.Properties.VariableNames)
                % Use the fluorescence type as a field name (sanitize if needed)
                fieldName = strrep(fluoroTypes{i}, 'Sample', '');
                fluoroChannels.(fieldName) = fluoroTypes{i};
            end
        end
        
        % Initialize results structure
        app.AUCValues = struct('absorbance', []);
        app.RelativeAbundanceValues = struct('absorbance', []);
        
        % Store autozero level for display
        autozeroLevel = NaN;
        
        % Calculate AUC for absorbance if available
        if ~isempty(absChannel)
            [absAUC, autozeroLvl] = app.calculateChannelAUC(x_data, selectedFile.(absChannel), x_selected, false);
            app.AUCValues.absorbance = absAUC;
            if ~isnan(autozeroLvl)
                autozeroLevel = autozeroLvl;
            end
            fprintf('Absorbance AUC calculated from %s channel\n', absChannel);
        end
        
        % Calculate AUC for each fluorescence channel
        fluoroFields = fieldnames(fluoroChannels);
        if ~isempty(fluoroFields)
            for i = 1:length(fluoroFields)
                fieldName = fluoroFields{i};
                channelName = fluoroChannels.(fieldName);
                
                [fluoroAUC, autozeroLvl] = app.calculateChannelAUC(x_data, selectedFile.(channelName), x_selected, app.AllFluoroSwitch.Value == "On");
                app.AUCValues.(fieldName) = fluoroAUC;
                if ~isnan(autozeroLvl)
                    autozeroLevel = autozeroLvl;
                end
                fprintf('Fluorescence AUC calculated from %s channel\n', channelName);
            end
        end
        
        % Build result text
        resultParts = {};
        
        % Add absorbance result if available
        if ~isempty(absChannel) && isfield(app.AUCValues, 'absorbance') && ~isempty(app.AUCValues.absorbance)
            absTotal = sum(app.AUCValues.absorbance);
            resultParts{end+1} = sprintf('Abs: %.4f', absTotal);
        end
        
        % Add each fluorescence channel result
        for i = 1:length(fluoroFields)
            fieldName = fluoroFields{i};
            if isfield(app.AUCValues, fieldName) && ~isempty(app.AUCValues.(fieldName))
                fluoroTotal = sum(app.AUCValues.(fieldName));
                resultParts{end+1} = sprintf('%s: %.4f', fieldName, fluoroTotal);
            end
        end
        
        % Combine all results
        app.AUCResult.Text = strjoin(resultParts, ' | ');
        
        % Calculate relative abundances
        app.calculateRelativeAbundance();
        
        % Update table with all values
        app.updateAPTable();
        
        % Highlight the selected region with autozero level
        app.highlightSelectedRegion(autozeroLevel);

        app.debugZeroingMethods(); % Temporary debug call
    end

    function [aucValues, autozeroLevel] = calculateRegionAUC(app, xData, yData, xBounds, zeroingMethod, channelName)
        % Enhanced AUC calculation with proper Curve Min Zero handling
        
        % Handle different input formats
        if size(xBounds, 1) > 2
            x_selected = xBounds(:,1);
            numSegments = length(x_selected) - 1;
        else
            x_selected = [min(xBounds); max(xBounds)];
            numSegments = 1;
        end
        
        % Clean data
        [xData_unique, unique_indices] = unique(xData);
        yData_unique = yData(unique_indices);
        
        % Apply fluorescence correction if needed
        if nargin >= 6 && app.isFluorescenceChannel(channelName) && app.AllFluoroSwitch.Value == "On"
            yMin_global = min(yData_unique);
            if yMin_global < 0
                yData_unique = yData_unique - yMin_global;
            end
        end
        
        % Interpolate y values for selected x points
        y_interp = interp1(xData_unique, yData_unique, x_selected, 'linear', 'extrap');
        
        % ENHANCED: Handle Curve Min Zero differently
        if strcmp(zeroingMethod, 'CurveMin')
            fprintf('Using FITTED BASELINE CURVE for Curve Min Zero AUC\n');
            
            % Calculate the fitted baseline first
            try
                percentile = app.determineOptimalPercentile(xData_unique, yData_unique);
                [baselineFit, baselineInfo] = app.quantileRollingBallBaseline(xData_unique, yData_unique, percentile);
                
                % Store for visualization
                app.lastBaselineFit = struct();
                app.lastBaselineFit.x = xData_unique;
                app.lastBaselineFit.y = baselineFit;
                app.lastBaselineFit.regions = baselineInfo.baselineRegions;
                app.lastBaselineFit.method = 'Quantile Rolling Ball';
                app.lastBaselineFit.ballRadius = baselineInfo.ballRadius;
                app.lastBaselineFit.percentile = baselineInfo.percentile;
                
                autozeroLevel = prctile(baselineFit, 5); % For display/logging only
                
            catch e
                fprintf('Error in baseline fitting: %s\n', E.message);
                zeroLevel = min(yData_unique);
                y_interp = y_interp - zeroLevel;
                autozeroLevel = zeroLevel;
            end
            
        else
            % For other methods, use single horizontal baseline
            zeroLevel = app.calculateZeroLevelGeneric(xData_unique, yData_unique, x_selected, zeroingMethod);
            
            if ~isnan(zeroLevel)
                y_interp = y_interp - zeroLevel;
                autozeroLevel = zeroLevel;
            else
                autozeroLevel = NaN;
            end
        end
        
        % Calculate AUC for each segment
        aucValues = zeros(1, numSegments);
        
        for i = 1:numSegments
            segment_x_bounds = x_selected(i:i+1);
            
            if strcmp(zeroingMethod, 'CurveMin') && ~isempty(app.lastBaselineFit) && isfield(app.lastBaselineFit, 'y')
                % PROPER Curve Min Zero: Integrate between data and fitted baseline
                
                % Get data points in this segment
                segmentMask = xData_unique >= segment_x_bounds(1) & xData_unique <= segment_x_bounds(2);
                x_segment = xData_unique(segmentMask);
                y_segment = yData_unique(segmentMask);
                baseline_segment = app.lastBaselineFit.y(segmentMask);
                
                if length(x_segment) > 1
                    % Integrate: AUC = integral of (data - baseline)
                    aucValues(i) = trapz(x_segment, y_segment - baseline_segment);
                    
                    fprintf('  Segment %d: AUC=%.6f (fitted baseline integration)\n', i, aucValues(i));
                    fprintf('    Data range: %.6f to %.6f\n', min(y_segment), max(y_segment));
                    fprintf('    Baseline range: %.6f to %.6f\n', min(baseline_segment), max(baseline_segment));
                else
                    aucValues(i) = 0;
                end
                
            else
                % Standard horizontal baseline method
                segment_y = y_interp(i:i+1);
                aucValues(i) = trapz(segment_x_bounds, segment_y);
            end
        end
        
        fprintf('Total AUC using %s method: %.6f\n', zeroingMethod, sum(aucValues));
    end
    
    function calculateRelativeAbundance(app)
        % Calculates relative percentage of each segment for all channels
        
        if isempty(app.AUCValues)
            warndlg('Please calculate AUC first.', 'Warning');
            return;
        end
        
        % Get all field names from AUCValues
        channelFields = fieldnames(app.AUCValues);
        
        % Calculate relative abundance for each channel
        for i = 1:length(channelFields)
            fieldName = channelFields{i};
            
            if isfield(app.AUCValues, fieldName) && ~isempty(app.AUCValues.(fieldName))
                channelAUC = app.AUCValues.(fieldName);
                totalChannelAUC = sum(channelAUC);
                
                if totalChannelAUC <= 0 || isnan(totalChannelAUC)
                    app.RelativeAbundanceValues.(fieldName) = [];
                    fprintf('Cannot calculate %s relative abundance - invalid total\n', fieldName);
                else
                    app.RelativeAbundanceValues.(fieldName) = (channelAUC ./ totalChannelAUC) * 100;
                    fprintf('%s relative abundances calculated\n', fieldName);
                end
            end
        end
    end
    
    function highlightSelectedRegion(app, autozeroLevel)
        % Highlights the region between selected points on the plot
        % Uses the ACTUAL baseline curve for Curve Min Zero, not just the zero level
        
        if nargin < 2
            autozeroLevel = NaN;
        end
        
        x_selected = app.selectedPoints(:,1);
        
        % Get the main data line (not baseline lines)
        plotLines = findobj(app.APPlot, 'Type', 'line');
        dataLine = [];
        
        for i = 1:length(plotLines)
            if strcmp(plotLines(i).Marker, 'none') && ...
               ~contains(plotLines(i).DisplayName, 'Baseline') && ...
               ~contains(plotLines(i).DisplayName, 'Zero')
                dataLine = plotLines(i);
                break;
            end
        end
        
        if isempty(dataLine)
            warning('No data line found to highlight');
            return;
        end
        
        % Get data
        xData = dataLine.XData;
        yData = dataLine.YData;
        
        % Find region boundaries
        xMin = min(x_selected);
        xMax = max(x_selected);
        idx_within_range = find(xData >= xMin & xData <= xMax);
        
        if isempty(idx_within_range)
            warning('No data points found within selected range');
            return;
        end
        
        % Get data within selection range
        idx_start = min(idx_within_range);
        idx_end = max(idx_within_range);
        x_highlight = xData(idx_start:idx_end);
        y_highlight = yData(idx_start:idx_end);
        
        % Determine baseline for highlighting
        selectedButton = app.ZeroingMethodButtonGroup.SelectedObject;
        
        if ~isempty(selectedButton) && strcmp(selectedButton.Text, 'Curve Min Zero') && ...
           ~isempty(app.lastBaselineFit) && isfield(app.lastBaselineFit, 'y')
            
            % For Curve Min Zero: use the actual fitted baseline curve
            baseline_x = app.lastBaselineFit.x;
            baseline_y = app.lastBaselineFit.y;
            
            % Interpolate baseline to match the highlighted region
            y_baseline_interp = interp1(baseline_x, baseline_y, x_highlight, 'linear', 'extrap');
            
            fprintf('Highlighting: Using Curve Min Zero fitted baseline curve\n');
            
        elseif ~isnan(autozeroLevel)
            % For other methods: use the calculated zero level
            y_baseline_interp = repmat(autozeroLevel, size(x_highlight));
            fprintf('Highlighting: Using calculated zero level %.6f\n', autozeroLevel);
            
        else
            % Fallback
            y_baseline_interp = repmat(min(yData), size(x_highlight));
            fprintf('Highlighting: Using data minimum baseline\n');
        end
        
        % Choose color
        highlightColor = [0.8, 0.2, 0.2];  % Red
        alpha = 0.3;
        
        % Create highlight patch
        hold(app.APPlot, 'on');
        if isfield(app, 'highlightPatch') && isgraphics(app.highlightPatch)
            delete(app.highlightPatch);
        end
        
        try
            x_highlight = x_highlight(:);
            y_highlight = y_highlight(:);
            y_baseline_interp = y_baseline_interp(:);
            
            % Create trapezoid between data and actual baseline
            app.highlightPatch = fill(app.APPlot, ...
                [x_highlight; flipud(x_highlight)], ...
                [y_highlight; flipud(y_baseline_interp)], ...
                highlightColor, 'FaceAlpha', alpha);
            
            app.highlightPatch.Annotation.LegendInformation.IconDisplayStyle = 'off';
            
            % Add vertical lines at selected points
            currentYLim = ylim(app.APPlot);
            for i = 1:length(x_selected)
                vertLine = line(app.APPlot, [x_selected(i), x_selected(i)], currentYLim, ...
                    'Color', [0.5, 0.5, 0.5], 'LineStyle', '--', 'LineWidth', 1);
                vertLine.Annotation.LegendInformation.IconDisplayStyle = 'off';
            end
            
        catch e
            warning('Error creating highlight patch: %s', E.message);
        end
        
        hold(app.APPlot, 'off');
    end

    function highlightPeak(app, peakIndex)
        % Highlight individual peak using trace analysis shading logic
        
        if peakIndex > size(app.detectedPeaks, 1)
            return;
        end
        
        peakX = app.detectedPeaks(peakIndex, 1);
        
        % Get data
        selectedIndex = find(strcmp(app.workspace(:,1), [app.RQWorkspaceDropDown.Value, '.csv']));
        selectedFile = app.workspace{selectedIndex, 2};
        x_data = app.getPositionData(selectedFile);
        y_data = selectedFile.(app.RQChannelDropDown.Value);
        
        % Find peak boundaries
        [peakStart, peakEnd] = app.findPeakBoundariesByValleys(x_data, y_data, peakX);
        
        % Create "fake selectedPoints" for existing highlight method
        fakeSelectedPoints = [peakStart, 0; peakEnd, 0]; % Y values don't matter for boundary detection
        
        % REUSE existing highlight logic
        tempSelectedPoints = app.selectedPoints; % Backup existing selection
        app.selectedPoints = fakeSelectedPoints;
        
        app.highlightSelectedRegion(NaN); % Use existing method!
        
        app.selectedPoints = tempSelectedPoints; % Restore
    end
    
    function updateAPTable(app)
        % Updates the analysis table with AUC and relative abundance for all channels
        
        if isempty(app.AUCValues)
            return;
        end
        
        % Get all channel fields
        channelFields = fieldnames(app.AUCValues);
        if isempty(channelFields)
            return;
        end
        
        % Determine max number of segments across all channels
        numSegments = 0;
        for i = 1:length(channelFields)
            fieldName = channelFields{i};
            if isfield(app.AUCValues, fieldName) && ~isempty(app.AUCValues.(fieldName))
                numSegments = max(numSegments, length(app.AUCValues.(fieldName)));
            end
        end
        
        if numSegments == 0
            return;
        end
        
        % Create segment numbers
        segmentNumbers = (1:numSegments)';
        
        % Initialize data cell array
        data = num2cell(segmentNumbers);
        columnNames = {'Segment'};
        
        % Add data for each channel (AUC and relative abundance)
        for i = 1:length(channelFields)
            fieldName = channelFields{i};
            
            if isfield(app.AUCValues, fieldName) && ~isempty(app.AUCValues.(fieldName))
                % Prepare AUC values
                channelAUC = nan(numSegments, 1);
                aucLength = length(app.AUCValues.(fieldName));
                channelAUC(1:aucLength) = app.AUCValues.(fieldName)';
                
                % Add AUC column
                data = [data, num2cell(channelAUC)];
                
                % Create appropriate column name based on channel
                if strcmp(fieldName, 'absorbance')
                    columnNames{end+1} = 'Abs AUC';
                else
                    columnNames{end+1} = [fieldName ' AUC'];
                end
                
                % Prepare relative abundance values if available
                if isfield(app.RelativeAbundanceValues, fieldName) && ~isempty(app.RelativeAbundanceValues.(fieldName))
                    relAbValues = nan(numSegments, 1);
                    relAbLength = length(app.RelativeAbundanceValues.(fieldName));
                    relAbValues(1:relAbLength) = app.RelativeAbundanceValues.(fieldName)';
                    
                    % Add relative abundance column
                    data = [data, num2cell(relAbValues)];
                    
                    % Create appropriate column name
                    if strcmp(fieldName, 'absorbance')
                        columnNames{end+1} = 'Abs %';
                    else
                        columnNames{end+1} = [fieldName ' %'];
                    end
                end
            end
        end
        
        % Update table
        app.APTable.Data = data;
        app.APTable.ColumnName = columnNames;
    end
    
