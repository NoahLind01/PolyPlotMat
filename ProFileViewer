        % Button pushed function: DetectPeaksButton
        function DetectPeaksButtonPushed(app, event)
            % Detect polysome peaks using islocalmax (consistent with our islocalmin approach)
    
            if strcmp(app.RQWorkspaceDropDown.Value, "No Data")
                warndlg('Please select a file first.', 'No Data');
                return;
            end
            
            try
                % Get current data
                selectedIndex = find(strcmp(app.workspace(:,1), [app.RQWorkspaceDropDown.Value, '.csv']));
                if isempty(selectedIndex)
                    warndlg('File not found in workspace.', 'Error');
                    return;
                end
                
                selectedFile = app.workspace{selectedIndex, 2};
                
                x_data = app.getPositionData(selectedFile);
                y_data = selectedFile.(app.RQChannelDropDown.Value);
                
                % Step 1: Focus on polysome region (40-75mm)
                polysomeRegion = x_data >= 40 & x_data <= 75;
                x_polysome = x_data(polysomeRegion);
                y_polysome = y_data(polysomeRegion);
                
                if isempty(x_polysome)
                    warndlg('No data found in polysome region (40-75mm).', 'No Polysome Data');
                    return;
                end
                
                % Step 2: Use islocalmax with sensitivity from numeric field
                if isprop(app, 'PeakSensitivityEditField')
                    sensitivity = app.PeakSensitivityEditField.Value;
                elseif isprop(app, 'BaslineballradiusEditField')
                    sensitivity = app.BaslineballradiusEditField.Value; % Fallback
                else
                    sensitivity = 2.0; % Default
                end
                
                % Calculate islocalmax parameters  
                minSeparation = max(2.0, sensitivity * 0.8); % Peaks must be at least this far apart
                dataRange = max(y_polysome) - min(y_polysome);
                minProminence = dataRange * 0.15 / sensitivity; % Higher sensitivity = lower prominence needed
                
                fprintf('  Using islocalmax for polysome peak detection\n');
                fprintf('    Sensitivity: %.2f → MinSeparation: %.2f, MinProminence: %.6f\n', ...
                    sensitivity, minSeparation, minProminence);
                
                % Find peaks using islocalmax
                [TF, prominence] = islocalmax(y_polysome, 'SamplePoints', x_polysome, ...
                                             'MinSeparation', minSeparation, ...
                                             'MinProminence', minProminence, ...
                                             'FlatSelection', 'center');
                
                peakIndices = find(TF);
                
                if isempty(peakIndices)
                    fprintf('    No peaks found - trying relaxed parameters...\n');
                    
                    % Try with more relaxed parameters
                    [TF_relaxed] = islocalmax(y_polysome, 'SamplePoints', x_polysome, ...
                                             'MinSeparation', minSeparation * 0.5, ...
                                             'MinProminence', minProminence * 0.3, ...
                                             'FlatSelection', 'center');
                    
                    peakIndices = find(TF_relaxed);
                    fprintf('    Relaxed islocalmax found: %d peaks\n', length(peakIndices));
                end
                
                % FIXED: Store detected peaks correctly
                if ~isempty(peakIndices)
                    peakPositions = x_polysome(peakIndices);
                    peakValues = y_polysome(peakIndices);
                    
                    % CLEAR OLD PEAKS FIRST, then add new ones
                    app.detectedPeaks = [peakPositions(:), peakValues(:)];
                    
                    fprintf('    islocalmax found: %d peaks - STORED\n', length(peakIndices));
                else
                    app.detectedPeaks = [];
                    fprintf('    No peaks found\n');
                end
                
                % Update visualization AFTER storing peaks
                app.visualizeDetectedPeaks();
                app.updatePeakCountDisplay();
                
                fprintf('Final result: %d polysome peaks stored and displayed\n', size(app.detectedPeaks, 1));

                catch e
                    errordlg(sprintf('Error detecting peaks: %s', E.message), 'Peak Detection Error');
                    fprintf('Peak detection error: %s\n', E.message);
                end
        end

