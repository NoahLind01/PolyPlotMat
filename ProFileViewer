                    currentXLim = app.TotalPolysomeAUCvsTime.XLim;
                    app.MinEditField_AUC.Value = currentXLim(1);
                    app.MaxEditField_AUC.Value = currentXLim(2);
                    fprintf('  Auto-scaled AUC X-axis, fields updated: [%.1f, %.1f]\n', currentXLim(1), currentXLim(2));
