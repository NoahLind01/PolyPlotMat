    function plotRunoffFile(app, fileData, channel, plotName)
        % Plot runoff data with main curve and peak restoration
        
        fprintf('=== PLOTTING RUNOFF FILE ===\n');
        fprintf('  File: %s, Channel: %s\n', plotName, channel);
        
        try
            % SAVE previous file's peaks if different file
            if ~strcmp(app.RQWorkspaceDropDown.Value, "No Data") && ...
               ~strcmp(app.RQWorkspaceDropDown.Value, plotName) && ...
               ~isempty(app.detectedPeaks)
                fprintf('  Saving previous file peaks before switching\n');
                app.saveCurrentFilePeaks();
            end
            
            % Clear existing plot and peak visuals
            cla(app.RQPlot);
            if isprop(app, 'peakLabels')
                app.peakLabels = [];
            end
            
            % Get data
            x_data = app.getPositionData(fileData);
            y_data = fileData.(channel);
            
            fprintf('  Data loaded: %d points, X[%.2f to %.2f], Y[%.4f to %.4f]\n', ...
                length(x_data), min(x_data), max(x_data), min(y_data), max(y_data));
            
            % Plot main data line
            hold(app.RQPlot, 'on');
            mainLine = plot(app.RQPlot, x_data, y_data, '-k', 'LineWidth', 1.5);
            mainLine.DisplayName = 'Polysome Profile';
            mainLine.Annotation.LegendInformation.IconDisplayStyle = 'off';
            
            % Set labels and title
            xlabel(app.RQPlot, 'Position (mm)');
            ylabel(app.RQPlot, 'Absorbance 260nm');
            title(app.RQPlot, sprintf('%s (%.1f min %s)', strrep(plotName, '_', ' '), ...
                app.currentRunoffMetadata.time, app.currentRunoffMetadata.condition));
            
            % Apply autoscaling
            newAxis = app.autoScalePolyPlot(x_data, y_data);
            app.RQPlot.YLim = newAxis;
            
            % Add polysome region indicator
            polysomeMin = 40;
            polysomeMax = 75;
            yLim = app.RQPlot.YLim;
            polysomeRegion = fill(app.RQPlot, [polysomeMin polysomeMax polysomeMax polysomeMin], ...
                [yLim(1) yLim(1) yLim(2) yLim(2)], [0.9 0.9 0.9], 'FaceAlpha', 0.3, 'EdgeColor', 'none');
            polysomeRegion.DisplayName = 'Polysome Region';
            polysomeRegion.PickableParts = 'none';
            polysomeRegion.HitTest = 'off';
            polysomeRegion.Annotation.LegendInformation.IconDisplayStyle = 'off';
            
            hold(app.RQPlot, 'off');
            
            fprintf('  Main plot elements created\n');
            
            % Load peaks for this file from storage
            if app.loadFilePeaksFromStorage(plotName)
                fprintf('  Restored peaks from storage\n');
            else
                app.detectedPeaks = [];
                fprintf('  New file - starting with no peaks\n');
            end
            
            fprintf('✓ Runoff file plotted: %s\n', plotName);
            
        catch e
            fprintf('!!! Error plotting runoff file: %s !!!\n', E.message);
            disp(getReport(e, 'extended'));
        end
    end

