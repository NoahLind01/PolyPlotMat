    function suggestOptimalTimeRange(app)
        % Suggest optimal time range for publication-ready plots
        
        if isempty(app.runoffAnalysisTable)
            return;
        end
        
        % Get time data range
        timeData = app.runoffAnalysisTable.Time;
        minTime = min(timeData);
        maxTime = max(timeData);
        timeRange = maxTime - minTime;
        
        % Suggest nice round numbers with padding
        padding = timeRange * 0.1; % 10% padding
        suggestedMin = floor((minTime - padding) * 10) / 10; % Round down to nearest 0.1
        suggestedMax = ceil((maxTime + padding) * 10) / 10;  % Round up to nearest 0.1
        
        % Ensure non-negative for time data
        suggestedMin = max(0, suggestedMin);
        
        % Get current time unit
        if app.MinutesButton.Value
            timeUnit = 'min';
        else
            timeUnit = 's';
        end
        
        fprintf('Suggested time range for publication: %.1f to %.1f %s\n', ...
            suggestedMin, suggestedMax, timeUnit);
        
        % Auto-populate the fields
        app.MinEditField_Poly.Value = suggestedMin;
        app.MaxEditField_Poly.Value = suggestedMax;
        app.MinEditField_AUC.Value = suggestedMin;
        app.MaxEditField_AUC.Value = suggestedMax;
        
        % Apply to plots
        app.PolysomePeakCountvsTime.XLim = [suggestedMin, suggestedMax];
        app.TotalPolysomeAUCvsTime.XLim = [suggestedMin, suggestedMax];
        
        fprintf('Applied suggested range to both plots\n');
    end

