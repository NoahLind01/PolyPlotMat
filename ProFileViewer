                        plot(app.TotalPolysomeAUCvsTime, timeData, aucData, ...
                            's-', 'Color', colors(i,:), 'LineWidth', 2, 'MarkerSize', markerSize, ...
                            'MarkerFaceColor', colors(i,:), 'DisplayName', conditions{i});
